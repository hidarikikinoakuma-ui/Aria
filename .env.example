# ============================================================
# Aria Docker Stack — Environment Variables
# ============================================================
# 1. Copy this file:   copy .env.example .env
# 2. Fill in your keys
# 3. docker compose up -d
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Your NVIDIA NIM API key — get free credits at build.nvidia.com
# Used when r5apex_dx12.exe is running (cloud AI, GPU stays free for Apex)
NIM_API_KEY=your_nim_api_key_here

# ── Local AI — Ollama (runs on your Windows host, NOT in Docker) ──
# Install: winget install Ollama.Ollama
# Pull model: ollama pull qwen2.5vl:7b

OLLAMA_MODEL=qwen2.5vl:7b

# ── Cloud AI — used during Apex matches ──────────────────────
# Model on cloud NIM to use when Apex is running
AI_MODEL_CLOUD=qwen/qwen3.5-vl

# ── Voice ─────────────────────────────────────────────────────
# Built-in XTTS v2 speaker (used when no voice clone WAV is present)
TTS_SPEAKER=Ana Florence

# ── Optional: Social Posting ──────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
